#!/usr/bin/env bash
# orla-nginx-prepare: runs as root before every Nginx start
# (ExecStartPre in /etc/systemd/system/nginx.service.d/orla.conf).
#
#  1. Ensure the directories Nginx and the panel share exist with the right
#     owners.
#  2. Ensure the self-signed fallback certificate for the default 443 server.
#  3. Probe the Nginx build (HTTP/3, modules) and the kernel (IPv6), write the
#     listen includes for the default servers and capabilities.json, which
#     the panel's template engine reads so it never emits unsupported
#     directives.
#  4. Validate the configuration. If the persisted generated files are
#     invalid, move them to /var/lib/orla/quarantine/<timestamp>/ so Nginx
#     still starts with the default servers; the panel recompiles them from
#     the database on its next start.
set -Eeuo pipefail

readonly ORLA_USER="orla"
readonly NGINX_USER="www-data"
readonly ENV_FILE="/etc/orla/orla.env"
readonly RUNTIME_DIR="/etc/nginx/orla/runtime"
readonly GENERATED_DIR="/etc/nginx/orla/generated"
readonly HOSTS_DIR="/etc/nginx/conf.d"
readonly DATA_DIR="/var/lib/orla"
readonly LOG_DIR="/var/log/orla"
readonly CACHE_DIR="/var/cache/orla/nginx"

log() {
    printf 'orla-nginx-prepare: %s\n' "$*"
}

# Reads KEY=value from the env file without sourcing it.
env_value() {
    local key="$1" default="$2" value=""
    if [[ -r "${ENV_FILE}" ]]; then
        value="$(sed -n "s/^${key}=//p" "${ENV_FILE}" | tail -n 1 | tr -d '"'"'"' \r')"
    fi
    printf '%s' "${value:-${default}}"
}

prepare_directories() {
    # Panel-owned state. www-data is a member of the `orla` group, so workers
    # can read the ACME webroot, htpasswd files and maintenance pages.
    install -d -o "${ORLA_USER}" -g "${ORLA_USER}" -m 0750 \
        "${DATA_DIR}" "${DATA_DIR}/acme" "${DATA_DIR}/snapshots" "${DATA_DIR}/quarantine" \
        "${GENERATED_DIR}" "${GENERATED_DIR}/http.d" "${GENERATED_DIR}/ip-lists" \
        "${GENERATED_DIR}/htpasswd" "${GENERATED_DIR}/www"
    # Private keys: only the panel (writer) and the root master (reader).
    install -d -o "${ORLA_USER}" -g "${ORLA_USER}" -m 0700 "${GENERATED_DIR}/certs"
    # Generated host files, written by the panel.
    install -d -o root -g "${ORLA_USER}" -m 2775 "${HOSTS_DIR}"
    # Logs written by Nginx, read by the panel's collector and live viewer.
    install -d -o root -g "${ORLA_USER}" -m 0755 "${LOG_DIR}"
    install -d -o "${NGINX_USER}" -g "${ORLA_USER}" -m 2750 "${LOG_DIR}/nginx"
    # proxy_cache, written by the workers.
    install -d -o "${NGINX_USER}" -g "${ORLA_USER}" -m 2750 "${CACHE_DIR}" "${CACHE_DIR}/proxy"
    install -d -o root -g "${ORLA_USER}" -m 0750 "${RUNTIME_DIR}"
}

ensure_fallback_certificate() {
    if [[ ! -s "${RUNTIME_DIR}/fallback.crt" || ! -s "${RUNTIME_DIR}/fallback.key" ]]; then
        log "generating self-signed fallback certificate"
        openssl req -x509 -nodes -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
            -days 3650 -subj "/CN=orla-fallback" \
            -keyout "${RUNTIME_DIR}/fallback.key" -out "${RUNTIME_DIR}/fallback.crt" >/dev/null 2>&1
    fi
    chown root:root "${RUNTIME_DIR}/fallback.key" "${RUNTIME_DIR}/fallback.crt"
    chmod 0600 "${RUNTIME_DIR}/fallback.key"
    chmod 0644 "${RUNTIME_DIR}/fallback.crt"
}

json_bool() {
    if "$@"; then printf 'true'; else printf 'false'; fi
}

module_enabled() {
    compgen -G "/etc/nginx/modules-enabled/*$1*" >/dev/null
}

probe_capabilities() {
    local nginx_build nginx_version http3 ipv6 ipv6_setting brotli headers_more
    nginx_build="$(nginx -V 2>&1)"
    nginx_version="$(nginx -v 2>&1 | sed -n 's|.*nginx/\([0-9.]*\).*|\1|p')"

    http3="$(json_bool grep -q -- '--with-http_v3_module' <<<"${nginx_build}")"
    if [[ "$(env_value ORLA_DISABLE_HTTP3 false)" == "true" ]]; then
        http3="false"
    fi

    ipv6_setting="$(env_value ORLA_IPV6 auto)"
    case "${ipv6_setting}" in
        true) ipv6="true" ;;
        false) ipv6="false" ;;
        *) ipv6="$(json_bool test -s /proc/net/if_inet6)" ;;
    esac

    brotli="$(json_bool module_enabled brotli)"
    headers_more="$(json_bool module_enabled headers-more)"

    {
        echo "# Generated by orla-nginx-prepare on every Nginx start."
        echo "listen 80 default_server;"
        if [[ "${ipv6}" == "true" ]]; then
            echo "listen [::]:80 default_server;"
        fi
    } >"${RUNTIME_DIR}/listen-default-http.conf"

    {
        echo "# Generated by orla-nginx-prepare on every Nginx start."
        echo "listen 443 ssl default_server;"
        if [[ "${ipv6}" == "true" ]]; then
            echo "listen [::]:443 ssl default_server;"
        fi
        if [[ "${http3}" == "true" ]]; then
            echo "listen 443 quic reuseport default_server;"
            if [[ "${ipv6}" == "true" ]]; then
                echo "listen [::]:443 quic reuseport default_server;"
            fi
        fi
    } >"${RUNTIME_DIR}/listen-default-https.conf"

    cat >"${RUNTIME_DIR}/capabilities.json" <<JSON
{
  "nginxVersion": "${nginx_version}",
  "http3": ${http3},
  "ipv6": ${ipv6},
  "brotli": ${brotli},
  "headersMore": ${headers_more}
}
JSON
    chown root:"${ORLA_USER}" "${RUNTIME_DIR}"/*.conf "${RUNTIME_DIR}/capabilities.json"
    chmod 0644 "${RUNTIME_DIR}"/*.conf "${RUNTIME_DIR}/capabilities.json"
    log "nginx ${nginx_version}: http3=${http3} ipv6=${ipv6} brotli=${brotli} headers_more=${headers_more}"
}

validate_or_quarantine() {
    local output target
    if output="$(nginx -t 2>&1)"; then
        return 0
    fi
    log "persisted configuration is invalid:"
    printf '%s\n' "${output}" >&2

    target="${DATA_DIR}/quarantine/$(date -u +%Y%m%dT%H%M%SZ)"
    log "moving generated files to ${target}; the panel recompiles them from the database"
    install -d -o "${ORLA_USER}" -g "${ORLA_USER}" -m 0750 "${target}" "${target}/conf.d" "${target}/http.d"
    find "${HOSTS_DIR}" -maxdepth 1 -name 'host-*.conf' -exec mv -t "${target}/conf.d" {} +
    find "${GENERATED_DIR}/http.d" -maxdepth 1 -name '*.conf' -exec mv -t "${target}/http.d" {} +

    nginx -t
}

main() {
    prepare_directories
    ensure_fallback_certificate
    probe_capabilities
    validate_or_quarantine
}

main "$@"
