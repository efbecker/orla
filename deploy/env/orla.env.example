# /etc/orla/orla.env (owner root:orla, mode 0640).
# deploy/install.sh creates this file with generated secrets on first install.

# PostgreSQL (Debian 13: PostgreSQL 17)
DATABASE_URL=postgresql://orla:CHANGE_ME@127.0.0.1:5432/orla?schema=public

# Panel listener. Prefer 127.0.0.1 or a VPN address in production.
ORLA_PANEL_HOST=0.0.0.0
ORLA_PANEL_PORT=81

# Secret used to sign panel JWTs (openssl rand -base64 48)
ORLA_JWT_SECRET=

# 32-byte key, base64, for AES-256-GCM encryption of private keys and DNS
# credentials at rest (openssl rand -base64 32)
ORLA_ENCRYPTION_KEY=

# First administrator, created on first start when the users table is empty.
ORLA_ADMIN_EMAIL=admin@example.com
ORLA_ADMIN_PASSWORD=

# Default e-mail for ACME accounts (Let's Encrypt / ZeroSSL). Let's Encrypt
# rejects example.com addresses; leave empty to set it later in the panel.
ORLA_ACME_EMAIL=

# IPv6 listeners: auto | true | false
ORLA_IPV6=auto

# true disables HTTP/3 even when the Nginx build supports it.
ORLA_DISABLE_HTTP3=false

TZ=America/Sao_Paulo
