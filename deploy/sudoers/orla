# Installed to /etc/sudoers.d/orla (mode 0440).
# The panel may only validate the Nginx configuration, reload Nginx and purge
# the proxy cache (the purge helper validates its own argument).
# Arguments are fixed: sudo rejects any other argument list.
Defaults:orla !requiretty
Defaults:orla env_reset

orla ALL=(root) NOPASSWD: /usr/sbin/nginx -t
orla ALL=(root) NOPASSWD: /usr/bin/systemctl reload nginx.service
orla ALL=(root) NOPASSWD: /usr/lib/orla/bin/orla-cache-purge all
orla ALL=(root) NOPASSWD: /usr/lib/orla/bin/orla-cache-purge [0-9]*
