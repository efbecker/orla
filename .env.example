# Copy to .env and fill in before `docker compose up -d --build`.

# Secret used to sign panel JWTs (generate with: openssl rand -base64 48)
ORLA_JWT_SECRET=

# 32-byte key, base64, for AES-256-GCM encryption of private keys and DNS
# credentials at rest (generate with: openssl rand -base64 32)
ORLA_ENCRYPTION_KEY=

# First administrator, created on first boot when the users table is empty.
ORLA_ADMIN_EMAIL=admin@example.com
ORLA_ADMIN_PASSWORD=

# Default e-mail for ACME accounts (Let's Encrypt / ZeroSSL).
ORLA_ACME_EMAIL=admin@example.com

# Panel exposure on the host (default 0.0.0.0:81). Prefer 127.0.0.1 or a VPN IP.
ORLA_PANEL_BIND=0.0.0.0
ORLA_PANEL_PORT_PUBLIC=81

# IPv6 listeners: auto | true | false
ORLA_IPV6=auto

# Set to true to disable HTTP/3 even if the Nginx build supports it.
ORLA_DISABLE_HTTP3=false

TZ=America/Sao_Paulo
